# Keep this file on the VPS only. Never commit real values.
# Image references are managed separately in /opt/littlecafe/.env.deploy.
POSTGRES_ADMIN_USER=required
POSTGRES_ADMIN_PASSWORD=required
IDENTITY_DB_USER=littlecafe_identity
IDENTITY_DB_PASSWORD=required
ORDER_DB_USER=littlecafe_order
ORDER_DB_PASSWORD=required
ACTIVITY_DB_USER=littlecafe_activity
ACTIVITY_DB_PASSWORD=required
WALLET_DB_USER=littlecafe_wallet
WALLET_DB_PASSWORD=required
AI_DB_USER=littlecafe_ai
AI_DB_PASSWORD=required
NOTIFICATION_DB_USER=littlecafe_notification
NOTIFICATION_DB_PASSWORD=required
REPORTING_DB_USER=littlecafe_reporting
REPORTING_DB_PASSWORD=required
REDIS_PASSWORD=required
RABBITMQ_USER=required
RABBITMQ_PASSWORD=required
API_DOMAIN=api.littlecafe.kids
WEB_ORIGIN=https://littlecafe.kids
CERTS_DIR=/opt/littlecafe/secrets/certs
TLS_DIR=/opt/littlecafe/secrets/tls
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY=/run/littlecafe/certs/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/certs/jwt-public.pem
GOOGLE_WEB_CLIENT_ID=required
GOOGLE_WEB_CLIENT_SECRET=required
GOOGLE_OAUTH_CALLBACK_URL=https://api.littlecafe.kids/api/v1/identity/oauth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=https://littlecafe.kids/auth/callback
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=required
PAYOS_API_KEY=required
PAYOS_CHECKSUM_KEY=required
PAYOS_RETURN_URL=https://littlecafe.kids/payment/success
PAYOS_CANCEL_URL=https://littlecafe.kids/payment/cancel
PAYOS_WEBHOOK_URL=https://api.littlecafe.kids/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false
BREVO_API_KEY=required
EMAIL_SENDER_EMAIL=no-reply@littlecafe.kids
REDIS_NAMESPACE=littlecafe:prod

