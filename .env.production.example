# ==============================================================================
# PRODUCTION ON VPS (/opt/littlecafe/.env.production)
# Fill in and copy to /opt/littlecafe/.env.production (chmod 600).
# NEVER commit real values. Key names must stay in sync with
# .env.production.example.
# Pure configuration (ports, limits, timeouts, providers) lives in configs/;
# this file only holds environment-specific values and secrets.
# Service images are NOT set here: the CD workflow writes pinned digests to
# /opt/littlecafe/.env.deploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (VPS runs http+worker in one process).
APP_MODE=all
SERVER_ENV=production
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DOMAINS, NGINX & PATHS
# ------------------------------------------------------------------------------
# On a VPS shared with another stack, keep these ports free for littlecafe.
# Use 80/443 only when this stack owns the host ports.
API_DOMAIN=api.littlecafe.kids
WEB_ORIGIN=https://littlecafe.kids
HTTP_PORT=8082
HTTPS_PORT=8444
CERTS_DIR=/opt/littlecafe-secrets/certs
JWT_DIR=/opt/littlecafe-secrets/jwt
# Shared TLS output for nginx; written by deployments/scripts/issue-certs.sh.
TLS_DIR=/opt/littlecafe-tls
# Certificates are issued and renewed with lego over the Vercel DNS-01 challenge.

# ------------------------------------------------------------------------------
# 3. POSTGRES BOOTSTRAP (Compose admin role)
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER=littlecafe_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# ------------------------------------------------------------------------------
# 4. APPLICATION DATABASE
# ------------------------------------------------------------------------------
# Per-service database passwords; DB_USER/DB_NAME are fixed in Compose and the
# admin role bootstraps the roles and databases in deployments/scripts/init-db.sh.
IDENTITY_DB_PASSWORD=replace_with_a_long_random_password
ORDER_DB_PASSWORD=replace_with_a_long_random_password
ACTIVITY_DB_PASSWORD=replace_with_a_long_random_password
WALLET_DB_PASSWORD=replace_with_a_long_random_password
AI_DB_PASSWORD=replace_with_a_long_random_password
NOTIFICATION_DB_PASSWORD=replace_with_a_long_random_password
REPORTING_DB_PASSWORD=replace_with_a_long_random_password

# ------------------------------------------------------------------------------
# 5. REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_a_long_random_redis_password
# Reserved: Redis key namespace prefix; not read by code yet.
REDIS_NAMESPACE=littlecafe:prod

# ------------------------------------------------------------------------------
# 6. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=replace_with_a_long_random_rabbitmq_password

# ------------------------------------------------------------------------------
# 7. JWT (ES256; only Identity holds the private key)
# ------------------------------------------------------------------------------
# JWT_DIR is mounted read-only into the containers. Only Identity receives the
# private key; the other services receive the public key only.
JWT_PRIVATE_KEY=/run/littlecafe/jwt/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/jwt/jwt-public.pem

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Identity)
# ------------------------------------------------------------------------------
# Fill in the production OAuth client before enabling Google login.
GOOGLE_WEB_CLIENT_ID=replace_with_the_production_web_client_id
GOOGLE_WEB_CLIENT_SECRET=replace_with_the_production_web_client_secret
GOOGLE_OAUTH_CALLBACK_URL=https://api.littlecafe.kids:8444/api/v1/identity/oauth/google/callback

# ------------------------------------------------------------------------------
# 9. EMAIL (Notification, Brevo)
# ------------------------------------------------------------------------------
# Disabled until a real Brevo API key is provided; set to true afterwards.
EMAIL_ENABLED=false
BREVO_API_KEY=replace_with_the_production_brevo_api_key

# ------------------------------------------------------------------------------
# 10. PAYOS (Wallet)
# ------------------------------------------------------------------------------
# Fill in the production payOS credentials before enabling payment.
PAYOS_CLIENT_ID=replace_with_the_production_payos_client_id
PAYOS_API_KEY=replace_with_the_production_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_the_production_payos_checksum_key
PAYOS_RETURN_URL=https://littlecafe.kids/payment/success
PAYOS_CANCEL_URL=https://littlecafe.kids/payment/cancel
PAYOS_WEBHOOK_URL=https://api.littlecafe.kids:8444/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false

# ------------------------------------------------------------------------------
# 11. CLOUDINARY (shared media adapter)
# ------------------------------------------------------------------------------
# Fill in the production Cloudinary credentials before enabling media uploads.
CLOUDINARY_CLOUD_NAME=replace_with_the_production_cloud_name
CLOUDINARY_API_KEY=replace_with_the_production_api_key
CLOUDINARY_API_SECRET=replace_with_the_production_api_secret
