# ==============================================================================
# STAGING ON THE SHARED VPS (/opt/littlecafe-staging/.env.staging)
# Fill in and copy to /opt/littlecafe-staging/.env.staging (chmod 600).
# NEVER commit real values. Key names must stay in sync with
# .env.staging.example.
# Pure configuration (ports, limits, timeouts, providers) lives in configs/;
# this file only holds environment-specific values and secrets.
# Service images are NOT set here: the staging CD workflow writes pinned
# digests to /opt/littlecafe-staging/.env.staging.deploy.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (one process runs HTTP and worker).
APP_MODE=all
SERVER_ENV=staging
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. DOMAINS, NGINX & PATHS
# ------------------------------------------------------------------------------
# Ports are non-standard because another stack already owns 80/443 on this VPS.
API_DOMAIN=staging-api.littlecafe.kids
WEB_ORIGIN=http://localhost:3000
HTTP_PORT=8081
HTTPS_PORT=8443
CERTS_DIR=/opt/littlecafe-staging-secrets/certs
JWT_DIR=/opt/littlecafe-staging-secrets/jwt
# Shared TLS output for nginx; written by deployments/scripts/issue-certs.sh.
TLS_DIR=/opt/littlecafe-tls
# Certificates are issued and renewed with lego over the Vercel DNS-01 challenge.

# ------------------------------------------------------------------------------
# 3. POSTGRES BOOTSTRAP (Compose admin role)
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER=littlecafe_staging_admin
POSTGRES_ADMIN_PASSWORD=replace_with_a_long_random_admin_password

# ------------------------------------------------------------------------------
# 4. APPLICATION DATABASE
# ------------------------------------------------------------------------------
# Per-service database passwords; the init-db job creates the roles and
# databases. DB_USER/DB_NAME are fixed in Compose.
IDENTITY_DB_PASSWORD=replace_with_a_long_random_password
ORDER_DB_PASSWORD=replace_with_a_long_random_password
ACTIVITY_DB_PASSWORD=replace_with_a_long_random_password
WALLET_DB_PASSWORD=replace_with_a_long_random_password
AI_DB_PASSWORD=replace_with_a_long_random_password
NOTIFICATION_DB_PASSWORD=replace_with_a_long_random_password
REPORTING_DB_PASSWORD=replace_with_a_long_random_password

# ------------------------------------------------------------------------------
# 5. REDIS
# ------------------------------------------------------------------------------
REDIS_PASSWORD=replace_with_a_long_random_redis_password
# Reserved: Redis key namespace prefix; not read by code yet.
REDIS_NAMESPACE=littlecafe:staging

# ------------------------------------------------------------------------------
# 6. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=replace_with_a_long_random_rabbitmq_password

# ------------------------------------------------------------------------------
# 7. JWT (ES256; only Identity holds the private key)
# ------------------------------------------------------------------------------
# JWT_DIR is mounted read-only into the containers. Only Identity receives the
# private key; the other services receive the public key only.
JWT_PRIVATE_KEY=/run/littlecafe/jwt/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/jwt/jwt-public.pem

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Identity) - use a test client for staging
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=replace_with_the_staging_web_client_id
GOOGLE_WEB_CLIENT_SECRET=replace_with_the_staging_web_client_secret
GOOGLE_OAUTH_CALLBACK_URL=https://staging-api.littlecafe.kids:8443/api/v1/identity/oauth/google/callback

# ------------------------------------------------------------------------------
# 9. EMAIL (Notification, Brevo) - disabled by default on staging
# ------------------------------------------------------------------------------
# Enabled only when a staging Brevo key is provided.
EMAIL_ENABLED=false
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 10. PAYOS (Wallet) - use sandbox credentials for staging
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=replace_with_the_staging_payos_client_id
PAYOS_API_KEY=replace_with_the_staging_payos_api_key
PAYOS_CHECKSUM_KEY=replace_with_the_staging_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=https://staging-api.littlecafe.kids:8443/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false

# ------------------------------------------------------------------------------
# 11. CLOUDINARY (shared media adapter) - use a test account for staging
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace_with_the_staging_cloud_name
CLOUDINARY_API_KEY=replace_with_the_staging_api_key
CLOUDINARY_API_SECRET=replace_with_the_staging_api_secret
