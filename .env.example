# ==============================================================================
# LOCAL DEVELOPMENT (.env)
# Copy this file to .env and fill in values. NEVER commit .env (gitignored).
# Key names must stay in sync with .env.example.
# Empty optional keys fall back to the YAML default in configs/base.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (local/VPS) | http | worker
APP_MODE=all
# SERVER_ENV: development | staging | production
SERVER_ENV=development
SERVER_PORT=8080
# Compose fixes the container gRPC port at 9090; only set this when running a
# service directly on the host.
GRPC_PORT=9090
# Timezone used by Compose and by host-run services.
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. CONFIG FILES & LOCAL PATHS
# ------------------------------------------------------------------------------
# The loader reads configs/base.yaml merged with configs/<service>.yaml.
CONFIG_BASE=configs/base.yaml
# Optional: override the per-service overlay path.
CONFIG_OVERLAY=
# Local certificates live OUTSIDE the repository (docs/operations/certificates.md).
CERTS_DIR=../../littlecafe-secrets/certs

# ------------------------------------------------------------------------------
# 3. POSTGRES BOOTSTRAP (Compose admin role)
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER=littlecafe_admin
POSTGRES_ADMIN_PASSWORD=local_admin_password

# ------------------------------------------------------------------------------
# 4. APPLICATION DATABASE
# ------------------------------------------------------------------------------
# Host-run defaults; Compose overrides host/port with its service names.
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Ho_Chi_Minh
# Optional: apply Goose migrations at startup (Compose sets true for dev).
DB_MIGRATE_ON_START=
# Per-service database passwords; the admin role bootstraps the roles in
# database/init/00-init.sql. DB_USER/DB_NAME are fixed in Compose.
IDENTITY_DB_PASSWORD=local_identity_password
ORDER_DB_PASSWORD=local_order_password
ACTIVITY_DB_PASSWORD=local_activity_password
WALLET_DB_PASSWORD=local_wallet_password
AI_DB_PASSWORD=local_ai_password
NOTIFICATION_DB_PASSWORD=local_notification_password
REPORTING_DB_PASSWORD=local_reporting_password

# ------------------------------------------------------------------------------
# 5. REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional overrides (defaults in configs/base.yaml).
REDIS_DB=
REDIS_TLS_ENABLED=
# Reserved: Redis key namespace prefix; not read by code yet.
REDIS_NAMESPACE=littlecafe:dev

# ------------------------------------------------------------------------------
# 6. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=local_rabbitmq_password
# Optional overrides (defaults in configs/base.yaml).
RABBITMQ_VHOST=
RABBITMQ_PREFETCH=
RABBITMQ_MANAGEMENT_PORT=
RABBITMQ_TLS_ENABLED=
RABBITMQ_MANAGEMENT_TLS_ENABLED=

# ------------------------------------------------------------------------------
# 7. JWT (ES256; only Identity holds the private key)
# ------------------------------------------------------------------------------
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY=/run/littlecafe/certs/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/certs/jwt-public.pem

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Identity)
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.littlecafe.kids/api/v1/identity/oauth/google/callback
# Optional: CSRF state TTL in minutes (default 10).
GOOGLE_STATE_TTL_MINUTES=

# ------------------------------------------------------------------------------
# 9. EMAIL (Notification, Brevo)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
# Optional overrides (defaults in configs/notification.yaml).
BREVO_ENDPOINT=
EMAIL_SENDER_NAME=
EMAIL_SENDER_EMAIL=no-reply@littlecafe.kids
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PAYOS (Wallet)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://littlecafe.kids/payment/success
PAYOS_CANCEL_URL=https://littlecafe.kids/payment/cancel
PAYOS_WEBHOOK_URL=https://api.littlecafe.kids/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false
# Optional overrides (defaults in configs/wallet.yaml).
PAYMENT_EXPIRED_MINUTES=
PAYMENT_RECONCILIATION_CRON=

# ------------------------------------------------------------------------------
# 11. CLOUDINARY (shared media adapter)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional overrides (defaults in configs/base.yaml).
CLOUDINARY_API_URL=
CLOUDINARY_FOLDER=

# ------------------------------------------------------------------------------
# 12. RATE LIMIT (optional; defaults 60 / 60 / 60)
# ------------------------------------------------------------------------------
RATE_LIMIT_TOKEN_LIMIT=
RATE_LIMIT_TOKENS_PER_PERIOD=
RATE_LIMIT_REPLENISHMENT_SECONDS=

# ------------------------------------------------------------------------------
# 13. OUTBOX (optional; defaults in configs/base.yaml)
# ------------------------------------------------------------------------------
OUTBOX_RETRY_MAX_ATTEMPTS=
OUTBOX_RETRY_INTERVAL_MINUTES=
OUTBOX_CLEANUP_RETENTION_DAYS=
OUTBOX_CLEANUP_INTERVAL_MINUTES=
OUTBOX_BATCH_SIZE=
OUTBOX_LISTENER_ENABLED=

# ------------------------------------------------------------------------------
# 14. SSE (optional; defaults 15 / 100 / 300)
# ------------------------------------------------------------------------------
SSE_HEARTBEAT_SECONDS=
SSE_REPLAY_BUFFER_SIZE=
SSE_REPLAY_BUFFER_TTL_SECONDS=

# ------------------------------------------------------------------------------
# 15. OBSERVABILITY & ADMIN (optional)
# ------------------------------------------------------------------------------
LOG_FILE_PATH=
ADMIN_AUDIT_RETENTION_MONTHS=
STARTUP_RETRY_1_SECONDS=
STARTUP_RETRY_2_SECONDS=
STARTUP_RETRY_3_SECONDS=

# ------------------------------------------------------------------------------
# 16. COMPOSE-ONLY
# ------------------------------------------------------------------------------
# Max request body size for the Nginx gateway (Compose default 20m).
NGINX_CLIENT_MAX_BODY_SIZE=20m
