# LittleCafe local development environment.
# Copy to .env and fill local paths/provider keys; .env is gitignored.
# Never commit real values.

# ------------------------------------------------------------------------------
# RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all | http | worker.
# CORS origins, comma-separated; "*" is allowed outside production.
APP_MODE=all
SERVER_ENV=development
LOG_LEVEL=debug
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# CONFIG FILES & LOCAL PATHS
# ------------------------------------------------------------------------------
# CERTS_DIR points outside the repo; JWT keys live there.
CONFIG_BASE=configs/base.yaml
CONFIG_OVERLAY=
CERTS_DIR=../../littlecafe-secrets/certs

# ------------------------------------------------------------------------------
# POSTGRES BOOTSTRAP
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER=littlecafe_admin
POSTGRES_ADMIN_PASSWORD=12345678

# ------------------------------------------------------------------------------
# APPLICATION DATABASE
# ------------------------------------------------------------------------------
# DB_HOST is for host-run; Compose overrides it.
# DB_MIGRATE_ON_START applies Goose migrations at startup.
DB_HOST=localhost
DB_MIGRATE_ON_START=
COMMERCE_DB_PASSWORD=12345678
EXPERIENCE_DB_PASSWORD=12345678
AI_DB_PASSWORD=12345678
PLATFORM_DB_PASSWORD=12345678

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
# Local Redis has no password by default.
# REDIS_NAMESPACE is reserved and not read yet.
REDIS_HOST=localhost
REDIS_PASSWORD=
REDIS_NAMESPACE=littlecafe:dev

# ------------------------------------------------------------------------------
# RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=12345678

# ------------------------------------------------------------------------------
# JWT (ES256)
# ------------------------------------------------------------------------------
# Only Commerce receives the private key.
JWT_PRIVATE_KEY=/run/littlecafe/certs/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/certs/jwt-public.pem

# ------------------------------------------------------------------------------
# GOOGLE OAUTH (Commerce)
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/identity/oauth/google/callback

# ------------------------------------------------------------------------------
# EMAIL (Platform, Brevo)
# ------------------------------------------------------------------------------
# Local development does not send email.
EMAIL_ENABLED=false
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# PAYOS (Commerce)
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:8080/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false

# ------------------------------------------------------------------------------
# CLOUDINARY (shared media adapter)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
