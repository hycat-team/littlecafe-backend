# ==============================================================================
# LOCAL DEVELOPMENT (.env)
# Copy this file to .env and fill in values. NEVER commit .env (gitignored).
# Key names must stay in sync with .env.example.
# Pure configuration (ports, limits, timeouts, providers) lives in configs/;
# this file only holds environment-specific values and secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME PROFILE
# ------------------------------------------------------------------------------
# APP_MODE: all (local/VPS) | http | worker
APP_MODE=all
# SERVER_ENV: development | staging | production
SERVER_ENV=development
LOG_LEVEL=debug
# CORS: comma-separated frontend origins. "*" is allowed outside production.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. CONFIG FILES & LOCAL PATHS
# ------------------------------------------------------------------------------
CONFIG_BASE=configs/base.yaml
CONFIG_OVERLAY=
# JWT keys live OUTSIDE the repository in this directory.
CERTS_DIR=../../littlecafe-secrets/certs

# ------------------------------------------------------------------------------
# 3. POSTGRES BOOTSTRAP (Compose admin role)
# ------------------------------------------------------------------------------
POSTGRES_ADMIN_USER=littlecafe_admin
POSTGRES_ADMIN_PASSWORD=12345678

# ------------------------------------------------------------------------------
# 4. APPLICATION DATABASE
# ------------------------------------------------------------------------------
# Host-run default; Compose overrides host with its service name.
DB_HOST=localhost
# Optional: apply Goose migrations at startup (Compose sets true for dev).
DB_MIGRATE_ON_START=
# Per-service passwords; the admin role bootstraps roles in
# database/init/00-init.sql. DB_USER/DB_NAME are fixed in Compose.
IDENTITY_DB_PASSWORD=12345678
ORDER_DB_PASSWORD=12345678
ACTIVITY_DB_PASSWORD=12345678
WALLET_DB_PASSWORD=12345678
AI_DB_PASSWORD=12345678
NOTIFICATION_DB_PASSWORD=12345678
REPORTING_DB_PASSWORD=12345678

# ------------------------------------------------------------------------------
# 5. REDIS
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
# Local Redis runs without a password in deployments/docker-compose.yml.
REDIS_PASSWORD=
# Reserved: Redis key namespace prefix; not read by code yet.
REDIS_NAMESPACE=littlecafe:dev

# ------------------------------------------------------------------------------
# 6. RABBITMQ
# ------------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=12345678

# ------------------------------------------------------------------------------
# 7. JWT (ES256; only Identity holds the private key)
# ------------------------------------------------------------------------------
JWT_PRIVATE_KEY=/run/littlecafe/certs/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/certs/jwt-public.pem

# ------------------------------------------------------------------------------
# 8. GOOGLE OAUTH (Identity)
# ------------------------------------------------------------------------------
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/api/v1/identity/oauth/google/callback

# ------------------------------------------------------------------------------
# 9. EMAIL (Notification, Brevo)
# ------------------------------------------------------------------------------
# Local development does not send email.
EMAIL_ENABLED=false
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 10. PAYOS (Wallet)
# ------------------------------------------------------------------------------
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/payment/success
PAYOS_CANCEL_URL=http://localhost:3000/payment/cancel
PAYOS_WEBHOOK_URL=http://localhost:8080/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false

# ------------------------------------------------------------------------------
# 11. CLOUDINARY (shared media adapter)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
