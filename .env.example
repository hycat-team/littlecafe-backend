# Local development only. Copy to .env and rotate every production secret.
APP_MODE=all
SERVER_ENV=development
CONFIG_FILE=configs/config.yaml
POSTGRES_ADMIN_USER=littlecafe_admin
POSTGRES_ADMIN_PASSWORD=local_admin_password
IDENTITY_DB_PASSWORD=local_identity_password
ORDER_DB_PASSWORD=local_order_password
ACTIVITY_DB_PASSWORD=local_activity_password
WALLET_DB_PASSWORD=local_wallet_password
AI_DB_PASSWORD=local_ai_password
NOTIFICATION_DB_PASSWORD=local_notification_password
REPORTING_DB_PASSWORD=local_reporting_password
REDIS_PASSWORD=
RABBITMQ_USER=littlecafe
RABBITMQ_PASSWORD=local_rabbitmq_password
JWT_ALGORITHM=ES256
JWT_PRIVATE_KEY=/run/littlecafe/certs/jwt-private.pem
JWT_PUBLIC_KEY=/run/littlecafe/certs/jwt-public.pem
GOOGLE_WEB_CLIENT_ID=
GOOGLE_WEB_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=https://api.littlecafe.kids/api/v1/identity/oauth/google/callback
OAUTH_SUCCESS_REDIRECT_URL=https://littlecafe.kids/auth/callback
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
PAYMENT_PROVIDER=payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=https://littlecafe.kids/payment/success
PAYOS_CANCEL_URL=https://littlecafe.kids/payment/cancel
PAYOS_WEBHOOK_URL=https://api.littlecafe.kids/api/v1/wallet/webhooks/payos
PAYOUT_ENABLED=false
EMAIL_ENABLED=true
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
EMAIL_SENDER_EMAIL=no-reply@littlecafe.kids
REDIS_NAMESPACE=littlecafe:dev
CERTS_DIR=../../littlecafe-secrets/certs
NGINX_PORT=8080
IDENTITY_HTTP_PORT=8101
ORDER_HTTP_PORT=8102
ACTIVITY_HTTP_PORT=8103
WALLET_HTTP_PORT=8104
AI_HTTP_PORT=8105
NOTIFICATION_HTTP_PORT=8106
REPORTING_HTTP_PORT=8107
IDENTITY_GRPC_PORT=9101
ORDER_GRPC_PORT=9102
ACTIVITY_GRPC_PORT=9103
WALLET_GRPC_PORT=9104

