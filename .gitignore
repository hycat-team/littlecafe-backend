# ---------------------------------------------------------------------------
# Keep entries generic; add project-specific rules under "Project-specific".
# ---------------------------------------------------------------------------

# Binaries for programs and plugins
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries, coverage and profiling output
*.test
*.out
coverage.*
*.coverprofile
profile.cov
*.prof

# Dependency directories (uncomment `vendor/` to commit vendored deps instead)
# vendor/

# Go workspace: go.work and go.work.sum ARE committed (multi-module workspace is
# part of the source). Do NOT ignore them.
#
# Generated code that IS committed on purpose (do NOT ignore):
#   - services/*/internal/di/wire_gen.go
#   - services/*/api/swagger/** (regenerated by `make swagger`)
#   - contracts/**/*.pb.go (regenerated by `make buf-gen`)

# Environment files (never commit real values; examples MUST be committed)
.env
.env.*
!*.example

# IDE / editors
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS
.DS_Store
Thumbs.db
Desktop.ini
._*
.directory

# Logs and local runtime state
logs/
*.log
tmp/
.cache/
*.pid

# Hot reload (Air)
.air.toml

# Secrets: never commit private keys or credential bundles
*.pem
*.key
*.p12
*.pfx
secrets/

# Local compose / config overrides
docker-compose.override.yml
deployments/*.local.yml
configs/*.local.yaml

# Local heavy artifacts
docs/temp/
node_modules/

# Merge and backup artifacts
*.bak
*.orig
*.rej

# Project-specific additions below this line
